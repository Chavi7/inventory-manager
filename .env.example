# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.
#
# In Portainer these are set as stack Environment variables instead of a file;
# the names are identical.

# REQUIRED. Long random string used to sign session cookies.
# The app refuses to start if this is blank, left as the placeholder above, or
# shorter than 16 characters.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
INVENTORY_SECRET_KEY=replace-with-a-long-random-string

# Optional. Shared secret for the CLOCKIN roster sync API. Must match
# CLOCKIN_API_KEY on the clockin container. Leave blank to keep CSV-only import.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
CLOCKIN_API_KEY=replace-with-a-long-random-string

# Host port. Default 5001 (5000 is CLOCKIN's).
INVENTORY_PORT=5001

# Container timezone. Without it the container runs in UTC, so checkout and
# dispense times are shifted and a late-evening checkout lands on the next day.
TZ=America/New_York

# Host address the container is published on.
#   127.0.0.1 (default) — only the server itself can reach it. Correct behind a
#                         reverse proxy.
#   0.0.0.0             — reachable from classroom PCs. Required for the scan
#                         station, which runs on a classroom computer.
INVENTORY_BIND=127.0.0.1
