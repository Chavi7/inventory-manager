# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Long random string used to sign session cookies.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
INVENTORY_SECRET_KEY=replace-with-a-long-random-string

# Shared secret for the CLOCKIN roster sync API. Must match CLOCKIN_API_KEY
# set on the clockin container. Leave blank to keep CSV-only import.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
CLOCKIN_API_KEY=replace-with-a-long-random-string
